{
    "compilerOptions": {
        "target": "ESNext",

        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "noEmit": true,

        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,

        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts"]
}