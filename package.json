{
  "name": "slide-deck-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --kill-others-on-fail \"ng serve --proxy-config proxy.conf.json\" \"npm run api\"",
    "api": "tsx server/index.ts",
    "build": "ng build",
    "check": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/index.test.ts",
    "preview": "ng serve --configuration production --proxy-config proxy.conf.json"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
